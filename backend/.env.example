# ===== 服务端环境变量（参考模板，复制为 .env 后按需填写；不要把真实密钥提交到 Git） =====

# 监听端口（云端平台会自动注入，本地默认 3000）
PORT=3000

# 短信验证码模式：
#   true  = 开发期 mock，验证码直接回传客户端/打印到服务端控制台（方便本地联调）
#   false = 生产模式，请先到 src/store.js 的 sendSmsCode 接入真实短信服务（阿里云/腾讯云/Twilio 等）
SMS_DEV=true

# 云端持久化（关键）：
#   设置后启用 Postgres，用户/宠物/消息数据跨重启不丢。
#   Render / Railway 的 Postgres 插件会自动注入该变量，本地无需设置（本地走 JSON 文件）。
# DATABASE_URL=postgres://user:password@host:5432/petchat?sslmode=require

# AI 反应 / 文生图 provider：mock | openai
#   mock   = 离线占位（无需密钥，适合联调）
#   openai = 真实调用，需同时设置 OPENAI_API_KEY
LLM_PROVIDER=mock
IMAGE_PROVIDER=mock
# OPENAI_API_KEY=sk-xxx
